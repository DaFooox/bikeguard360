# Port of the web server
PORT=3000
# Path to the SQLite database file
DB_PATH=./data/bikeguard360.db
# Session lifetime in hours
SESSION_TTL_HOURS=168
# Minutes without data after which a device counts as offline
OFFLINE_AFTER_MIN=15
# Optional: push alarms to an ntfy topic (https://ntfy.sh), e.g. https://ntfy.sh/my-secret-topic
NTFY_URL=
