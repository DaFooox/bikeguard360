{
  "name": "bikeguard360",
  "version": "0.1.0",
  "description": "BikeGuard360 – Diebstahlerkennung und GPS-Ortung für Fahrräder (ESP32 + Node.js-Server + Weboberfläche)",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --experimental-sqlite --disable-warning=ExperimentalWarning --watch server/index.js",
    "seed": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/seed.js",
    "simulate": "node scripts/simulate.js",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.22.3",
    "leaflet": "^1.9.4"
  }
}
